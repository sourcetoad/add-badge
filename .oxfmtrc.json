{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["bin"],
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": {
    "newlinesBetween": true,
    "groups": [
      "side_effect",
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
